#compdef trot

autoload -U is-at-least

_trot() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_trot_commands" \
"*::: :->trot" \
&& ret=0
    case $state in
    (trot)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trot-command-$line[1]:"
        case $line[1] in
            (daemon)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(diagnose)
_arguments "${_arguments_options[@]}" : \
'--duration=[Capture duration, including discovery (1–600 seconds)]:DURATION:_default' \
'--output=[Destination ZIP; never overwritten. A .partial.json file is retained on failure]:OUTPUT:_files' \
'--device=[Exact advertised name or platform ID (standalone only; duplicate names require picker)]:DEVICE:_default' \
'--display-unit=[Console display unit for a standalone capture]:DISPLAY_UNIT:(km/h mph)' \
'--note=[Optional console readings/model/firmware to accompany the trace; do not include secrets]:NOTE:_default' \
'--inventory[Only scan/discover GATT, with no telemetry queries or subscriptions (standalone)]' \
'--non-interactive[Do not show a picker. Requires --device when no daemon is running]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(today)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(log)
_arguments "${_arguments_options[@]}" : \
'--limit=[How many to show]:LIMIT:_default' \
'--week[Only sessions from the last 7 days]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(scan)
_arguments "${_arguments_options[@]}" : \
'--seconds=[How long to scan for, in seconds (1–15)]:SECONDS:_default' \
'--all[Show every Bluetooth device, not just treadmills]' \
'--list[Just print the list; don'\''t show the interactive picker]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(devices)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pair)
_arguments "${_arguments_options[@]}" : \
'--name=[A friendly name to remember it by]:NAME:_default' \
'-h[Print help]' \
'--help[Print help]' \
':device_id -- The device id printed by `trot scan`:_default' \
&& ret=0
;;
(unpair)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--install[Write it where the shell will find it, instead of printing to stdout]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::shell -- bash · zsh · fish · powershell · elvish. Guessed from $SHELL if omitted:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_trot__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trot-help-command-$line[1]:"
        case $line[1] in
            (daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(diagnose)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(today)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(log)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(scan)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(devices)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pair)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unpair)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_trot_commands] )) ||
_trot_commands() {
    local commands; commands=(
'daemon:Run the tracking daemon (talks to the treadmill, serves the API)' \
'diagnose:Record a bounded BLE support bundle (no upload or workout database)' \
'today:Today'\''s totals' \
'status:Whether the daemon is up and a treadmill is connected' \
'log:Recent sessions' \
'scan:Scan for nearby treadmills and pick one to pair (interactive)' \
'devices:List paired treadmills (the active one is marked with *)' \
'pair:Pair a treadmill from \`trot scan\` and make it the active one' \
'unpair:Forget the active treadmill' \
'completions:Print (or install) a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'trot commands' commands "$@"
}
